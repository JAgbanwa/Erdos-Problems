PaperIV.RootPartitionStability.sum_rootPieceDefect_eq.{u_1} {V : Type u_1} [Fintype V] [DecidableEq V]
  {G : SimpleGraph V} [DecidableRel G.Adj] (R : Finset V) (hR : G.IsClique ↑R)
