PaperIV.RootPartitionStability.chordal_partition_stability :
  ∃ N,
    ∀ (n : ℕ),
      N ≤ n →
        ∀ (G : SimpleGraph (Fin n)) [inst : DecidableRel G.Adj],
          PaperIV.FarRounding.IsChordal G →
            ∀ (δ : ℚ),
              0 ≤ δ →
                δ ≤ PaperIV.IntegralStability.gamma * ↑n ^ 2 →
                  (∀ (Q : PaperIV.FarRounding.CliquePartition G),
                      Q.OrderAtMost 4 → ↑(PaperIV.targetSize n) - δ ≤ ↑Q.size) →
                    ∃ R,
                      G.IsClique ↑R ∧
                        2 ≤ R.card ∧
                          R.card ≤ (Finset.univ \ R).card ∧
                            ∀ (Q : PaperIV.FarRounding.CliquePartition G) (τ : ℚ),
                              ↑Q.size ≤ ↑(PaperIV.targetSize n) + τ →
                                ↑(PaperIV.RootPartitionStability.noncanonicalPieces R Q).card ≤ τ + 48 * δ
