  ∑ K ∈ Q.pieces, PaperIV.RootPartitionStability.rootPieceDefect R K =
    ↑Q.size - PaperIV.splitBaseline ↑(Fintype.card V) ↑R.card + ↑(PaperIV.RootVocab.missingIncidences G R) +
