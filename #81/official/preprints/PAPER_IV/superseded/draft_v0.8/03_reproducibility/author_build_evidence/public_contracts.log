constructor:
  PaperIV.FarRounding.CliquePartition.mk.{u_1} {V : Type u_1} [Fintype V] [DecidableEq V] {G : SimpleGraph V}
    [DecidableRel G.Adj] (pieces : Finset (Finset V)) (isClique : ∀ K ∈ pieces, ∀ a ∈ K, ∀ b ∈ K, a ≠ b → G.Adj a b)
    (two_le_card : ∀ K ∈ pieces, 2 ≤ K.card)
    (edgeDisjoint : ∀ K ∈ pieces, ∀ L ∈ pieces, K ≠ L → Disjoint (pairs K) (pairs L))
    (covers : pieces.biUnion pairs = G.edgeFinset) : CliquePartition G
def PaperIV.FarRounding.CliquePartition.OrderAtMost.{u_1} : {V : Type u_1} →
  [inst : Fintype V] →
    [inst_1 : DecidableEq V] → {G : SimpleGraph V} → [inst_2 : DecidableRel G.Adj] → CliquePartition G → ℕ → Prop :=
fun {V} [Fintype V] [DecidableEq V] {G} [DecidableRel G.Adj] Q r => ∀ K ∈ Q.pieces, K.card ≤ r
@[reducible] def PaperIV.FarRounding.IsChordal.{u_1} : {V : Type u_1} → SimpleGraph V → Prop :=
fun {V} G => G.IsChordal
def PaperIV.targetSize : ℕ → ℕ :=
fun n => n * (n + 1) / 6
