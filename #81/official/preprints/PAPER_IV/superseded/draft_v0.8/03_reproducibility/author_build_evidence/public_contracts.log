theorem PaperIV.Erdos81AllOrders.erdos81_all_orders_additive : ∃ b,
  ∀ (n : ℕ) (G : SimpleGraph (Fin n)) [inst : DecidableRel G.Adj],
    IsChordal G → ∃ Q, Q.OrderAtMost 4 ∧ Q.size ≤ PaperIV.targetSize n + b :=
Exists.casesOn PaperIV.Erdos81Unconditional.erdos81_cliquePartition fun N hN =>
  Exists.intro (N * N) fun n G [DecidableRel G.Adj] hG =>
    Or.casesOn (Nat.lt_or_ge n N)
      (fun hsmall =>
        Exists.casesOn (PaperIV.Erdos81AllOrders.exists_trivial_cliquePartition G) fun Q h =>
          And.casesOn h fun hQ4 hQsize =>
            Exists.intro Q
              ⟨hQ4,
                have hcard :=
                  Eq.mp
                    (congrArg (LE.le (2 * G.edgeFinset.card))
                      (congr (congrArg HMul.hMul (Fintype.card_fin n)) (Fintype.card_fin n)))
                    (PaperIV.Erdos81AllOrders.card_edgeFinset_le✝ G);
                have hnn := Nat.mul_le_mul (le_of_lt hsmall) (le_of_lt hsmall);
                Decidable.byContradiction fun a =>
                  PaperIV.Erdos81AllOrders.erdos81_all_orders_additive._proof_1_1 N n G Q hQsize hcard hnn a⟩)
      fun hbig =>
      Exists.casesOn (hN n hbig G hG) fun Q h =>
        And.casesOn h fun hQ4 hQsize =>
          Exists.intro Q
            ⟨hQ4,
              Decidable.byContradiction fun a =>
                PaperIV.Erdos81AllOrders.erdos81_all_orders_additive._proof_1_2 N n G Q hQsize a⟩
