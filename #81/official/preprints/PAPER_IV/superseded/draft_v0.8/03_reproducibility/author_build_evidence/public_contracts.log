theorem PaperIV.Erdos81Unconditional.erdos81_cliquePartition : ∃ N,
  ∀ (n : ℕ),
    N ≤ n →
      ∀ (G : SimpleGraph (Fin n)) [inst : DecidableRel G.Adj],
        IsChordal G → ∃ Q, Q.OrderAtMost 4 ∧ Q.size ≤ PaperIV.targetSize n :=
Exists.casesOn PaperIV.Erdos81Unconditional.erdos81_cliquePartition_of_certificate fun N hN =>
  Exists.intro N fun n hn G [DecidableRel G.Adj] hG =>
    Exists.casesOn (PaperIV.CertifiedOptimumExistence.exists_certifiedFractionalOptimum G) fun w hw => hN n hn G hG w hw
theorem PaperIV.PaperTheorems.erdos81_max_eq : ∃ N,
  ∀ (n : ℕ),
    N ≤ n →
      (∀ (G : SimpleGraph (Fin n)) [inst : DecidableRel G.Adj],
          G.IsChordal → ∃ Q, Q.OrderAtMost 4 ∧ Q.size ≤ PaperIV.targetSize n) ∧
        ∃ G x,
          G.IsChordal ∧
            ∃ Q, Q.OrderAtMost 4 ∧ Q.size = PaperIV.targetSize n ∧ ∀ (R : CliquePartition G), Q.size ≤ R.size :=
Exists.casesOn PaperIV.Erdos81Unconditional.erdos81_cliquePartition fun N hN =>
  Exists.intro (max N 6) fun n hn =>
    ⟨fun G [DecidableRel G.Adj] hG => hN n (le_trans (le_max_left N 6) hn) G hG,
      PaperIV.PaperTheorems.exists_chordal_extremal_witness (le_trans (le_max_right N 6) hn)⟩
