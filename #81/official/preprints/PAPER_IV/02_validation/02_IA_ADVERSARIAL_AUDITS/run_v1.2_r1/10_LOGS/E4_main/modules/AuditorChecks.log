      N ≤ n →
        ∀ (G : SimpleGraph (Fin n)) [inst : DecidableRel G.Adj],
          PaperIV.RootedSimplicialDefect.RootedDefectAt G s →
            ∃ Q, Q.OrderAtMost 4 ∧ Q.size ≤ PaperIV.DefectTargetArithmetic.defectTarget s n
PaperIV.DefectExplicitPublication.rooted_defect_maximum : ∀ (s : ℕ),
