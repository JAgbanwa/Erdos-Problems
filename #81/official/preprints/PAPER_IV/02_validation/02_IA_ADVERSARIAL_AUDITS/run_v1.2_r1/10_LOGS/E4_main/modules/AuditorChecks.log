PaperIV.Erdos81AllOrders.erdos81_all_orders_additive : ∃ b,
  ∀ (n : ℕ) (G : SimpleGraph (Fin n)) [inst : DecidableRel G.Adj],
    PaperIV.FarRounding.IsChordal G → ∃ Q, Q.OrderAtMost 4 ∧ Q.size ≤ PaperIV.targetSize n + b
PaperIV.Erdos81Unconditional.erdos81_cliquePartition : ∃ N,
  ∀ (n : ℕ),
    N ≤ n →
      ∀ (G : SimpleGraph (Fin n)) [inst : DecidableRel G.Adj],
        PaperIV.FarRounding.IsChordal G → ∃ Q, Q.OrderAtMost 4 ∧ Q.size ≤ PaperIV.targetSize n
PaperIV.PaperTheorems.erdos81_max_eq : ∃ N,
  ∀ (n : ℕ),
    N ≤ n →
      (∀ (G : SimpleGraph (Fin n)) [inst : DecidableRel G.Adj],
          G.IsChordal → ∃ Q, Q.OrderAtMost 4 ∧ Q.size ≤ PaperIV.targetSize n) ∧
        ∃ G x,
          G.IsChordal ∧
            ∃ Q,
              Q.OrderAtMost 4 ∧
                Q.size = PaperIV.targetSize n ∧ ∀ (R : PaperIV.FarRounding.CliquePartition G), Q.size ≤ R.size
PaperIV.DefectExplicitPublication.rooted_defect_eventual : ∀ (s : ℕ),
