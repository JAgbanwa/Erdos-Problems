    (card_def : D.card = s) (two_le : 2 ≤ C.card) (core_le_hosts : C.card ≤ H.card) : E32.IsDefectRoot G s C D H
def E32.IsCanonicalPiece.{u_1} : {V : Type u_1} → [DecidableEq V] → Finset V → Finset V → Finset V → Finset V → Prop :=
fun {V} [DecidableEq V] C D H K ↦
  (∃ x ∈ C ∪ D, ∃ h ∈ H, x ≠ h ∧ K = {x, h}) ∨ ∃ c ∈ C, ∃ c' ∈ C, ∃ h ∈ H, c ≠ c' ∧ K = {c, c', h}
def PaperIV.DefectComparatorGraph.defSplitGraph.{u_1} : {V : Type u_1} →
  [DecidableEq V] → Finset V → Finset V → Finset V → SimpleGraph V :=
fun {V} [DecidableEq V] Core Def Hosts ↦
  { Adj := fun x y ↦ x ≠ y ∧ (x ∈ Core ∧ y ∈ Core ∨ x ∈ Core ∪ Def ∧ y ∈ Hosts ∨ x ∈ Hosts ∧ y ∈ Core ∪ Def), symm := ⋯,
    loopless := ⋯ }
