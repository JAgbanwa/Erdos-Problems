              ∃ Q, Q.OrderAtMost 4 ∧ Q.size ≤ PaperIV.DefectTargetArithmetic.defectTarget s n) ∧
          ∃ G x,
            PaperIV.RootedSimplicialDefect.RootedDefectAt G s ∧
              ∃ Q,
                Q.OrderAtMost 4 ∧
                  Q.size = PaperIV.DefectTargetArithmetic.defectTarget s n ∧
                    ∀ (R : PaperIV.FarRounding.CliquePartition G), Q.size ≤ R.size
PaperIV.SublinearResearch.fixed_defect_joint_stability_real : ∀ (s n : ℕ),
  PaperIV.SublinearResearch.FixedExplicit.stabilityThreshold s ≤ n →
    ∀ (G : SimpleGraph (Fin n)) [inst : DecidableRel G.Adj],
      PaperIV.RootedSimplicialDefect.RootedDefectAt G s →
        ∀ (δ : ℝ),
          0 ≤ δ →
            δ ≤ ↑(PaperIV.SublinearResearch.FixedExplicit.stabilityGamma s) * ↑n ^ 2 →
              (∀ (Q : PaperIV.FarRounding.CliquePartition G),
                  Q.OrderAtMost 4 → ↑(PaperIV.DefectTargetArithmetic.defectTarget s n) - δ ≤ ↑Q.size) →
                ∃ C D H,
                  E32.IsDefectRoot G s C D H ∧
                    ↑(E32.rootEdit G C D H) ≤ ↑(PaperIV.SublinearResearch.FixedExplicit.stabilityConstant s) * δ ∧
                      0 ≤ ↑(PaperIV.DefectTargetArithmetic.defectTarget s n) - ↑(E32.rootBaseline C D H) ∧
                        ↑(PaperIV.DefectTargetArithmetic.defectTarget s n) - ↑(E32.rootBaseline C D H) ≤
                            (1 + 4 * ↑(PaperIV.SublinearResearch.FixedExplicit.stabilityConstant s)) * δ ∧
                          ∀ (Q : PaperIV.FarRounding.CliquePartition G) (τ : ℝ),
                            ↑Q.size ≤ ↑(PaperIV.DefectTargetArithmetic.defectTarget s n) + τ →
                              ↑{K ∈ Q.pieces | ¬E32.IsCanonicalPiece C D H K}.card ≤
                                  τ + (1 + 7 * ↑(PaperIV.SublinearResearch.FixedExplicit.stabilityConstant s)) * δ ∧
                                ↑(PaperIV.SublinearResearch.defectNoncanonicalEdgeMass C D H Q) ≤
                                  10 * τ +
                                    10 * (1 + 7 * ↑(PaperIV.SublinearResearch.FixedExplicit.stabilityConstant s)) * δ
PaperIV.SublinearResearch.fixed_defect_exact_extremal_edit_real : ∀ (s n : ℕ),
  PaperIV.SublinearResearch.FixedExplicit.stabilityThreshold s ≤ n →
    ∀ (G : SimpleGraph (Fin n)) [inst : DecidableRel G.Adj],
      PaperIV.RootedSimplicialDefect.RootedDefectAt G s →
        ∀ (δ : ℝ),
          0 ≤ δ →
            δ ≤ ↑(PaperIV.SublinearResearch.FixedExplicit.stabilityGamma s) * ↑n ^ 2 →
              (∀ (Q : PaperIV.FarRounding.CliquePartition G),
                  Q.OrderAtMost 4 → ↑(PaperIV.DefectTargetArithmetic.defectTarget s n) - δ ≤ ↑Q.size) →
                ∃ T _inst,
                  E32.IsAdmissibleExtremal T s ∧
                    ↑(PaperIV.EditMetric.editDist G.edgeFinset T.edgeFinset) ≤
                      ↑(PaperIV.SublinearResearch.FixedExplicit.stabilityConstant s) * δ +
                        ↑n * √((1 + 4 * ↑(PaperIV.SublinearResearch.FixedExplicit.stabilityConstant s)) * δ)
PaperIV.SublinearResearch.chordal_joint_stability_real : ∃ N,
  ∀ (n : ℕ),
    N ≤ n →
      ∀ (G : SimpleGraph (Fin n)) [inst : DecidableRel G.Adj],
        G.IsChordal →
          ∀ (δ : ℝ),
            0 ≤ δ →
              δ ≤ ↑PaperIV.IntegralStability.gamma * ↑n ^ 2 →
                (∀ (Q : PaperIV.FarRounding.CliquePartition G),
                    Q.OrderAtMost 4 → ↑(PaperIV.targetSize n) - δ ≤ ↑Q.size) →
                  ∃ R,
                    G.IsClique ↑R ∧
                      2 ≤ R.card ∧
                        R.card ≤ (Finset.univ \ R).card ∧
                          ↑(PaperIV.EditMetric.editDist G.edgeFinset
                                  (PaperIV.GraphFamilyDistance.graphEdgeSupport
                                    (PaperIV.SplitUniformIncidence.splitGraph R (Finset.univ \ R)))) ≤
                              16 * δ ∧
                            0 ≤ ↑(PaperIV.targetSize n) - ↑(PaperIV.splitBaseline ↑n ↑R.card) ∧
                              ↑(PaperIV.targetSize n) - ↑(PaperIV.splitBaseline ↑n ↑R.card) +
                                      ↑(PaperIV.RootVocab.outsideEdges G R).card / 16 +
                                    ↑(PaperIV.RootVocab.missingIncidences G R) / 2 ≤
                                  δ ∧
                                ∀ (Q : PaperIV.FarRounding.CliquePartition G) (τ : ℝ),
                                  ↑Q.size ≤ ↑(PaperIV.targetSize n) + τ →
                                    ↑(PaperIV.RootPartitionStability.noncanonicalPieces R Q).card ≤ τ + 48 * δ ∧
                                      ↑(PaperIV.SublinearResearch.noncanonicalEdgeMass R Q) ≤ 10 * τ + 480 * δ
PaperIV.SublinearResearch.sequence_arbitrary_orders_stability : ∀ (order : ℕ → ℕ),
  Filter.Tendsto order Filter.atTop Filter.atTop →
    ∀ (G : (n : ℕ) → SimpleGraph (Fin (order n))) [inst : (n : ℕ) → DecidableRel (G n).Adj] (s : ℕ → ℕ) (δ : ℕ → ℚ),
      (∀ (n : ℕ), PaperIV.RootedSimplicialDefect.RootedDefectAt (G n) (s n)) →
        ((fun n ↦ ↑(s n)) =o[Filter.atTop] fun n ↦ ↑(order n)) →
          ((fun n ↦ ↑(δ n)) =o[Filter.atTop] fun n ↦ ↑(order n) ^ 2) →
            (∀ᶠ (n : ℕ) in Filter.atTop,
                ∀ (Q : PaperIV.FarRounding.CliquePartition (G n)),
                  Q.OrderAtMost 4 → ↑(order n) ^ 2 / 6 - δ n ≤ ↑Q.size) →
              ∃ R,
                (∀ (n : ℕ), (G n).IsClique ↑(R n)) ∧
                  ((fun n ↦ ↑(R n).card - ↑(order n) / 3) =o[Filter.atTop] fun n ↦ ↑(order n)) ∧
                    ((fun n ↦
                          ↑(PaperIV.RootVocab.missingIncidences (G n) (R n)) +
                            ↑(PaperIV.RootVocab.outsideEdges (G n) (R n)).card) =o[Filter.atTop]
                        fun n ↦ ↑(order n) ^ 2) ∧
                      ∃ e,
                        (∀ (n : ℕ), 0 ≤ e n) ∧
                          ((fun n ↦ ↑(e n)) =o[Filter.atTop] fun n ↦ ↑(order n) ^ 2) ∧
                            (∀ (n : ℕ) (Q : PaperIV.FarRounding.CliquePartition (G n)) (τ : ℚ),
                                ↑Q.size ≤ ↑(PaperIV.targetSize (order n)) + τ →
                                  ↑(PaperIV.RootPartitionStability.noncanonicalPieces (R n) Q).card ≤ τ + e n) ∧
                              ∀ (n : ℕ) (Q : PaperIV.FarRounding.CliquePartition (G n)) (τ : ℚ),
                                ↑Q.size ≤ ↑(PaperIV.targetSize (order n)) + τ →
                                  ↑(PaperIV.SublinearResearch.noncanonicalEdgeMass (R n) Q) ≤ 10 * τ + 10 * e n
PaperIV.OptimalTemplateObstruction.shifted_template_sqrt_witness : ∀ (n s q d : ℕ),
  n + s = 3 * q →
    2 * s + 2 ≤ q →
      1 ≤ d →
        2 * d ≤ q →
          ∃ G x,
            PaperIV.RootedSimplicialDefect.RootedDefectAt G s ∧
              ∃ Q,
                Q.OrderAtMost 4 ∧
                  Q.size + PaperIV.OptimalTemplateObstruction.displacementDeficit d =
                      PaperIV.DefectTargetArithmetic.defectTarget s n ∧
                    (∀ (R : PaperIV.FarRounding.CliquePartition G), Q.size ≤ R.size) ∧
                      ∀ (T : SimpleGraph (Fin n)) [inst : DecidableRel T.Adj],
                        E32.IsAdmissibleExtremal T s →
                          ↑n * √↑(PaperIV.OptimalTemplateObstruction.displacementDeficit d) / 8 ≤
                            ↑(PaperIV.EditMetric.editDist G.edgeFinset T.edgeFinset)
E35.theoremC_tower_uniform : ∀ (n S : ℕ),
  E19.tower2 (E35.Ptower S) ≤ n →
    ∀ s ≤ S,
      ∀ (G : SimpleGraph (Fin n)) [inst : DecidableRel G.Adj],
        PaperIV.RootedSimplicialDefect.RootedDefectAt G s →
          ∃ Q, Q.OrderAtMost 4 ∧ Q.size ≤ PaperIV.DefectTargetArithmetic.defectTarget s n
def PaperIV.RootedSimplicialDefect.RootedDefectAt.{u_1} : {V : Type u_1} →
  [DecidableEq V] → (G : SimpleGraph V) → [DecidableRel G.Adj] → ℕ → Prop :=
fun {V} [DecidableEq V] G [DecidableRel G.Adj] s ↦
  ∀ (U R : Finset V),
    R ⊆ U → G.IsClique ↑R → (U \ R).Nonempty → ∃ v ∈ U \ R, PaperIV.RootedSimplicialDefect.DefectSimplicialOn G U s v
